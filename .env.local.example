# Copy this file to .env.local and fill the values from your Firebase project settings
# ÖRNEK DOSYA — gerçek değerleri buraya YAZMAYIN.
# Gerçek değerler yalnızca .env.local içinde tutulmalı ve asla commit edilmemelidir.

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google Maps (Frontend Forge proxy)
# VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
# VITE_FRONTEND_FORGE_API_KEY=your-forge-api-key

# Analytics (Umami)
# VITE_ANALYTICS_ENDPOINT=https://your-analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=your-website-id

# SOS otomatik SMS (true/false)
# VITE_SOS_AUTO_SMS=false
