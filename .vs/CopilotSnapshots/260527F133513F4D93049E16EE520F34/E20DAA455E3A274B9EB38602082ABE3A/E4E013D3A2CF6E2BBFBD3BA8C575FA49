export async function updateProductRealtime(id, patch) {
  if (!db) return null;
  try {
	const ref = collection(db, "products");
	// Firestore update requires doc reference; use addDoc etc. but here we'll use addDoc for simplicity if id absent
	// For update we need doc ref from id
	const { doc, updateDoc } = await import('firebase/firestore');
	const dref = doc(db, "products", id);
	return updateDoc(dref, patch);
  } catch (e) {
	console.error('updateProductRealtime error', e);
	return null;
  }
}

