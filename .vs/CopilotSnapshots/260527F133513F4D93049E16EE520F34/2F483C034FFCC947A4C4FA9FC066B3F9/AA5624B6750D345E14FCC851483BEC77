import React, { createContext, useContext, useEffect, useState } from "react";
import { v4 as uuidv4 } from "nanoid";

type Message = {
  id: string;
  from: string | null;
  text: string;
  ts: number;
};

type HelpRequest = {
  id: string;
  title: string;
  description: string;
  user?: string | null;
  lat?: number;
  lng?: number;
  createdAt: number;
  active: boolean;
};

type MessageContextType = {
  helpRequests: HelpRequest[];
  messages: Record<string, Message[]>;
  createHelpRequest: (r: Omit<HelpRequest, "id" | "createdAt" | "active">) => HelpRequest;
  sendMessage: (requestId: string, text: string, from?: string | null) => Message;
};

const MessageContext = createContext<MessageContextType | undefined>(undefined);

const STORAGE_KEY = "motosos_help_requests_v1";

export function MessageProvider({ children }: { children: React.ReactNode }) {
  const [helpRequests, setHelpRequests] = useState<HelpRequest[]>(() => {
	try {
	  const raw = localStorage.getItem(STORAGE_KEY);
	  return raw ? JSON.parse(raw).helpRequests || [] : [];
	} catch (e) {
	  return [];
	}
  });

  const [messages, setMessages] = useState<Record<string, Message[]>>(() => {
	try {
	  const raw = localStorage.getItem(STORAGE_KEY);
	  return raw ? JSON.parse(raw).messages || {} : {};
	} catch (e) {
	  return {};
	}
  });

  useEffect(() => {
	localStorage.setItem(STORAGE_KEY, JSON.stringify({ helpRequests, messages }));
  }, [helpRequests, messages]);

  function createHelpRequest(r: Omit<HelpRequest, "id" | "createdAt" | "active">) {
	const id = uuidv4();
	const hr: HelpRequest = { ...r, id, createdAt: Date.now(), active: true };
	setHelpRequests((s) => [hr, ...s]);
	// initialize messages
	setMessages((m) => ({ ...m, [id]: [] }));
	return hr;
  }

  function sendMessage(requestId: string, text: string, from: string | null = null) {
	const msg: Message = { id: uuidv4(), from, text, ts: Date.now() };
	setMessages((m) => {
	  const arr = m[requestId] ? [...m[requestId], msg] : [msg];
	  return { ...m, [requestId]: arr };
	});
	return msg;
  }

  const value: MessageContextType = {
	helpRequests,
	messages,
	createHelpRequest,
	sendMessage,
  };

  return <MessageContext.Provider value={value}>{children}</MessageContext.Provider>;
}

export function useMessages() {
  const ctx = useContext(MessageContext);
  if (!ctx) throw new Error("useMessages must be used within MessageProvider");
  return ctx;
}

export default MessageContext;
