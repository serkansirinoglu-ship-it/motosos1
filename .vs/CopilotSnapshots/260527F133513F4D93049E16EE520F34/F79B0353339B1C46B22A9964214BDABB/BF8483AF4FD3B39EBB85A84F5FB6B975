import { useState, useEffect, useRef } from "react";
import { useMessages } from "@/contexts/MessageContext";
import { useAuth } from "@/contexts/AuthContext";
import { useRoute } from "wouter";
import { Card } from "@/components/ui/card";
import { Button } from "@/components/ui/button";

export default function ChatPage() {
  const [match, params] = useRoute("/chat/:id");
  const id = params?.id as string | undefined;
	const { messages, sendMessage, helpRequests, subscribeToMessages } = useMessages();
  const { user } = useAuth();
  const [text, setText] = useState("");
	const [localMsgs, setLocalMsgs] = useState<any[]>([]);
  const listRef = useRef<HTMLDivElement | null>(null);

	useEffect(() => {
	// subscribe to realtime messages for this chat if supported
	if (!id) return;
	if (subscribeToMessages) {
	  const unsub = subscribeToMessages(id, (arr: any[]) => setLocalMsgs(arr));
	  return () => unsub && unsub();
	}
	return;
  }, [id, subscribeToMessages]);

	useEffect(() => {
	// scroll to bottom when messages change
	const el = listRef.current;
	const len = (localMsgs.length || messages[id || ""]?.length) as number;
	if (el) el.scrollTop = el.scrollHeight;
  }, [localMsgs.length, messages[id || ""]?.length]);

  if (!id) return <div>Geçersiz sohbet.</div>;

	const msgs = localMsgs.length ? localMsgs : messages[id] || [];
  const req = helpRequests.find((r) => r.id === id);
  const { acceptHelp, resolveHelp, getHelpCount } = useMessages();
  const userEmail = user?.email || null;

  function handleSend() {
	if (!text.trim()) return;
	sendMessage(id, text.trim(), user?.email || null);
	setText("");
  }

  function handleAccept(){
	if(!userEmail) { window.__openAuthModal && window.__openAuthModal(); return; }
	acceptHelp(id, userEmail);
	toast.success('Yardım kabul edildi.');
  }

  function handleResolveClick(){
	if(!userEmail) { window.__openAuthModal && window.__openAuthModal(); return; }
	resolveHelp(id, userEmail);
	toast.success('Yardım çözümü kaydedildi. Rozet/puan güncellendi.');
  }

  return (
	<div className="min-h-screen bg-asphalt px-4 pt-6 flex flex-col">
	  <header className="mb-4">
		<h1 className="font-display text-2xl font-bold text-white">{req?.title || "Yardım Talebi"}</h1>
		<p className="text-xs text-muted-foreground">{req?.description}</p>
	  </header>

	  <div className="flex-1 overflow-auto mb-4" ref={listRef}>
		<div className="space-y-3">
		  {msgs.map((m) => (
			<div key={m.id} className={`p-3 rounded-xl max-w-[80%] ${m.from === user?.email ? 'ml-auto bg-primary text-white' : 'bg-card-gradient text-foreground'}`}>
			  <div className="text-xs text-muted-foreground mb-1">{m.from || 'Anonim'}</div>
			  <div>{m.text}</div>
			  <div className="text-[10px] text-muted-foreground mt-1">{new Date(m.ts).toLocaleTimeString()}</div>
			</div>
		  ))}
		</div>
	  </div>

	  <div className="flex gap-2">
		<input value={text} onChange={(e) => setText(e.target.value)} className="flex-1 px-3 py-2 rounded-md bg-card-gradient border border-border" placeholder="Mesaj yazın..." />
		<Button onClick={handleSend}>Gönder</Button>
	  </div>
	</div>
  );
}
