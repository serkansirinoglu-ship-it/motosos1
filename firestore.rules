rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Users collection: each user can read/write only their own profile
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'city', 'motorcycle', 'photoURL', 'bio',
          'privacyLocation', 'points', 'helpCount', 'receivedHelpCount', 'badges',
          'createdAt', 'updatedAt', 'contacts'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.points == 0
        && request.resource.data.helpCount == 0
        && request.resource.data.receivedHelpCount == 0
        && request.resource.data.badges is list
        && request.resource.data.badges.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'city', 'motorcycle', 'photoURL', 'bio',
          'privacyLocation', 'contacts', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin();
    }

    // SOS requests: authenticated users can create; owner can update/cancel;
    // helpers can read active requests; admin full access
    match /sosRequests/{sosId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'requesterId', 'requesterEmail', 'helpType', 'latitude', 'longitude',
          'note', 'status', 'acceptedBy', 'createdAt', 'updatedAt',
          'resolvedAt', 'cancelledAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.helpType in ['lastik', 'aku', 'yakit', 'ariza', 'kaza', 'cekici', 'diger', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.acceptedBy == null
        && request.resource.data.resolvedAt == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Active SOS calls are visible to authenticated helpers; inactive records stay private.
      allow read: if isAdmin()
        || (isSignedIn() && (
          resource.data.requesterId == request.auth.uid
          || resource.data.status == 'active'
        ));
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['cancelled', 'resolved']
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin();
    }

    // Active help requests are discoverable; closed requests are limited to owner/helpers.
    match /helpRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'user', 'lat', 'lng', 'createdAt',
          'active', 'helpers', 'resolvedBy', 'resolvedAt'
        ])
        && request.resource.data.user == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.active == true
        && request.resource.data.helpers is list
        && request.resource.data.helpers.size() == 0
        && request.resource.data.resolvedBy == null
        && request.resource.data.resolvedAt == null
        && request.resource.data.createdAt == request.time
        && (!('lat' in request.resource.data) || (request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90))
        && (!('lng' in request.resource.data) || (request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180));
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.active == true
        || resource.data.user == request.auth.token.email
        || (request.auth.token.email != null && resource.data.helpers is list && request.auth.token.email in resource.data.helpers)
      ));
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.user == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
          && request.resource.data.active == false
          && request.resource.data.updatedAt == request.time)
        || (isSignedIn()
          && resource.data.active == true
          && request.auth.token.email != null
          && resource.data.helpers is list
          && !(request.auth.token.email in resource.data.helpers)
          && resource.data.user != request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpers', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.helpers is list
          && request.resource.data.helpers.hasAll(resource.data.helpers)
          && request.resource.data.helpers.size() == resource.data.helpers.size() + 1
          && request.auth.token.email in request.resource.data.helpers)
        || (isSignedIn()
          && request.auth.token.email != null
          && resource.data.helpers is list
          && request.auth.token.email in resource.data.helpers
          && resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'resolvedBy', 'resolvedAt', 'updatedAt'])
          && request.resource.data.active == false
          && request.resource.data.resolvedBy == request.auth.token.email
          && request.resource.data.resolvedAt == request.time);
      allow delete: if isAdmin();

      // Only the request owner or a listed helper can read/send messages in that request.
      match /messages/{messageId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.token.email != null && (
          get(/databases/$(database)/documents/helpRequests/$(requestId)).data.user == request.auth.token.email
          || (get(/databases/$(database)/documents/helpRequests/$(requestId)).data.helpers is list
            && request.auth.token.email in get(/databases/$(database)/documents/helpRequests/$(requestId)).data.helpers)
        ));
        allow create: if isAdmin() || (isSignedIn()
          && request.auth.token.email != null
          && request.resource.data.keys().hasOnly(['id', 'from', 'text', 'ts'])
          && request.resource.data.from == request.auth.token.email
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.ts == request.time
          && (
            get(/databases/$(database)/documents/helpRequests/$(requestId)).data.user == request.auth.token.email
            || (get(/databases/$(database)/documents/helpRequests/$(requestId)).data.helpers is list
              && request.auth.token.email in get(/databases/$(database)/documents/helpRequests/$(requestId)).data.helpers)
          ));
        allow update, delete: if isAdmin();
      }
    }

    // Products: public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Banners: public read, admin write
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Community posts: authenticated users can create; owner can update/delete
    match /communityPosts/{postId} {
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow read: if true;
      allow update: if isSignedIn()
        && (
          resource.data.authorId == request.auth.uid
          || isAdmin()
        );
      allow delete: if isSignedIn()
        && (
          resource.data.authorId == request.auth.uid
          || isAdmin()
        );
    }

    // Events: public read, authenticated create, owner/admin update/delete
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (
          resource.data.organizerId == request.auth.uid
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    // Listings: public read, authenticated create, owner/admin update/delete
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          resource.data.sellerId == request.auth.uid
          || isAdmin()
        );
      allow delete: if isSignedIn()
        && (
          resource.data.sellerId == request.auth.uid
          || isAdmin()
        );
    }

    // Online presence: only the authenticated owner can maintain their minimal heartbeat.
    // Public read is limited to uid + lastSeen fields so the client can display an aggregate count.
    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'lastSeen'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastSeen == request.time;
      allow delete: if isOwner(uid);
    }

    // Default deny: public access must be granted explicitly by collection rules.
    // Never make every current and future collection readable through a catch-all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}